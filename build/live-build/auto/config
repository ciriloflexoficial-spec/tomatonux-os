#!/bin/sh
set -e

lb config noauto \
  --distribution trixie \
  --architecture amd64 \
  --binary-image iso-hybrid \
  --bootloaders "grub-pc grub-efi" \
  --archive-areas "main contrib non-free-firmware" \
  --image-name tomatonux-0.0.1 \
  --iso-application "Tomatonux OS Live" \
  --iso-publisher "Tomatinho OSS" \
  --iso-volume TOMATONUX_001 \
  --system live \
  --initsystem systemd \
  --bootappend-live "boot=live components console=tty0 console=ttyS0,115200n8" \
  "$@"
