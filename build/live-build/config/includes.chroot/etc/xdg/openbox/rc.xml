<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">

  <keyboard>
    <keybind key="W-r">
      <action name="Execute">
        <command>/usr/local/bin/tomatonux-iniciar</command>
      </action>
    </keybind>
    <keybind key="W-e">
      <action name="Execute">
        <command>pcmanfm</command>
      </action>
    </keybind>
    <keybind key="W-t">
      <action name="Execute">
        <command>xfce4-terminal</command>
      </action>
    </keybind>
    <keybind key="W-f">
      <action name="Execute">
        <command>firefox-esr</command>
      </action>
    </keybind>
  </keyboard>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <focusDelay>200</focusDelay>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
  </theme>

  <desktops>
    <number>2</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>Área de trabalho 1</name>
      <name>Área de trabalho 2</name>
    </names>
  </desktops>
</openbox_config>
