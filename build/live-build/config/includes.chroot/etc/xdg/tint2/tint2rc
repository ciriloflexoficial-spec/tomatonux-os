# Tomatonux OS 0.1 - barra de tarefas centralizada

# Fundos
rounded = 2
border_width = 1
border_sides = TBLR
background_color = #1a0808 95
border_color = #5a1010 100

rounded = 2
border_width = 0
background_color = #2a0c0c 80
border_color = #000000 0

rounded = 2
border_width = 1
border_sides = B
background_color = #b71c1c 90
border_color = #ff5252 100

# Painel
panel_monitor = all
panel_position = bottom center horizontal
panel_size = 520 44
panel_margin = 0 0
panel_padding = 8 2 8
panel_background_id = 1
panel_items = LTSC
panel_dock = 0
panel_layer = top
strut_policy = follow_size
wm_menu = 1
mouse_left = toggle
mouse_right = close

# Botão Iniciar
launcher_padding = 4 2 4
launcher_background_id = 2
launcher_icon_size = 28
launcher_item_app = /usr/share/applications/tomatonux-iniciar.desktop

# Barra de tarefas (apps abertos)
taskbar_mode = single_desktop
taskbar_padding = 4 2 4
taskbar_background_id = 0
task_icon = 1
task_text = 1
task_centered = 1
task_maximum_size = 180 36
task_padding = 6 2 6
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 3
task_iconified_background_id = 2
task_font = Sans 9
task_font_color = #ffffff 100
task_active_font_color = #ffffff 100
task_icon_asb = 100 0 0

# Bandeja
systray = 1
systray_padding = 4 2 4
systray_background_id = 0
systray_icon_size = 22

# Relógio
time1_format = %H:%M
time1_font = Sans 9
time2_format = %d/%m
clock_font_color = #ffffff 100
clock_padding = 6 0
clock_background_id = 0
